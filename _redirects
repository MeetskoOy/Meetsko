# Myyntisivun kieliversiot: suomi osoitteessa /fi/ (sama tiedosto kuin
# index.html), englanti osoitteessa /en/.
/fi/   /index.html   200

# Etusivu (/): kielivalitsimen nf_lang-eväste ensin, sitten selaimen kieli ja
# lopuksi maa. Language-ehto lukee nf_lang-evästeen (tai sen puuttuessa
# selaimen kielen); Country-ehto ei lue evästettä, joten muu valittu kieli
# ohjataan englantiin ennen maasääntöä.
/      /index.html   200!  Language=fi
/      /en/          302!  Cookie=nf_lang
/      /index.html   200!  Country=fi
/      /en/          302!
